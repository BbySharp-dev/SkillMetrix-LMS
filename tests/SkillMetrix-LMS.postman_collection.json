									"    pm.expect(json.data.user.email).to.eql('testuser@postman.dev');",
									"    pm.expect(json.data.user.role).to.eql('Student');",
									"",
									"    pm.collectionVariables.set('newUserToken', json.data.accessToken);",
									"    pm.collectionVariables.set('newUserRefreshToken', json.data.refreshToken);",
									"});"
