	"item": [
		{
			"name": "0. Seed & Setup",
			"description": "Seed test data and prepare the environment",
			"item": [
				{
					"name": "Seed Strict Data",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Seed completed successfully', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Seed response has correct structure', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.data).to.have.property('message');",
									"    pm.expect(json.data).to.have.property('counts');",
									"    pm.expect(json.data).to.have.property('credentials');",
									"    pm.expect(json.data.counts.users).to.be.above(0);",
									"    pm.expect(json.data.counts.courses).to.be.above(0);",
									"    pm.expect(json.data.counts.chapters).to.be.above(0);",
									"    pm.expect(json.data.counts.lessons).to.be.above(0);",
									"    pm.expect(json.data.counts.enrollments).to.be.above(0);",
									"});",
									"",
									"pm.test('Store default password', function () {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('defaultPassword', json.data.defaultPassword);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": { "raw": "{{baseUrl}}/api/dev/seed/strict", "host": ["{{baseUrl}}"], "path": ["api", "dev", "seed", "strict"] }
					}
				}
			]
		},
