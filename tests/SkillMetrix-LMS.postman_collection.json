		{
			"name": "2. Courses",
			"description": "Full CRUD + workflow (submit/approve/reject) for courses",
			"item": [
				{
					"name": "Get All Courses (Public)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Get courses returns 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has pagination', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.data).to.have.property('data');",
									"    pm.expect(json.data).to.have.property('pageNumber');",
									"    pm.expect(json.data).to.have.property('pageSize');",
									"    pm.expect(json.data).to.have.property('totalRecords');",
									"});",
									"",
									"// Store a published course for later enrollment",
									"var json = pm.response.json();",
									"if (json.data.data && json.data.data.length > 0) {",
									"    pm.collectionVariables.set('publishedCourseId', json.data.data[0].id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/courses?pageNumber=1&pageSize=5&Status=Published",
							"host": ["{{baseUrl}}"],
							"path": ["api", "courses"],
							"query": [
								{ "key": "pageNumber", "value": "1" },
								{ "key": "pageSize", "value": "5" },
								{ "key": "Status", "value": "Published" }
							]
						}
					}
				},
				{
					"name": "Get Courses - Filter by Price",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Price filter works', function () {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    if (json.data.data.length > 0) {",
									"        json.data.data.forEach(function(c) {",
									"            pm.expect(c.price).to.be.at.most(300000);",
									"        });",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/courses?MinPrice=100000&MaxPrice=300000&SortBy=price",
							"host": ["{{baseUrl}}"],
							"path": ["api", "courses"],
							"query": [
								{ "key": "MinPrice", "value": "100000" },
								{ "key": "MaxPrice", "value": "300000" },
								{ "key": "SortBy", "value": "price" }
							]
						}
					}
				},
				{
					"name": "Create Course (Instructor)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Course created - 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Store courseId', function () {",
