{
	"info": {
		"_postman_id": "skillmetrix-lms-full-test",
		"name": "SkillMetrix LMS - Full API Test Suite",
		"description": "Comprehensive test suite for SkillMetrix LMS API.\n\n**How to use:**\n1. Import this collection into Postman\n2. Run requests in order (top to bottom) — they chain data automatically\n3. Or use Postman Runner to run the entire collection\n\n**Flow:** Seed → Auth → Courses → Chapters → Lessons → Enrollments → Progress → Transactions → Cleanup",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:5015" },
		{ "key": "adminEmail", "value": "admin@skillmetrix.dev" },
		{ "key": "instructorEmail", "value": "instructor1@skillmetrix.dev" },
		{ "key": "instructor2Email", "value": "instructor2@skillmetrix.dev" },
		{ "key": "studentEmail", "value": "student1@skillmetrix.dev" },
		{ "key": "defaultPassword", "value": "Password@123" },
		{ "key": "adminToken", "value": "" },
		{ "key": "adminRefreshToken", "value": "" },
		{ "key": "instructorToken", "value": "" },
		{ "key": "instructorRefreshToken", "value": "" },
		{ "key": "instructorId", "value": "" },
		{ "key": "studentToken", "value": "" },
		{ "key": "studentRefreshToken", "value": "" },
		{ "key": "studentId", "value": "" },
		{ "key": "newUserToken", "value": "" },
		{ "key": "newUserRefreshToken", "value": "" },
		{ "key": "courseId", "value": "" },
		{ "key": "publishedCourseId", "value": "" },
